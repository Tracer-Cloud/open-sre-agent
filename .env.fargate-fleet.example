# Local control-plane lifecycle environment for the shared Fargate fleet.
#
# Production Lambda values come from modules/fargate_fleet outputs
# (`fleet_environment`). Use this file only when running the control plane
# outside the deployed Lambda.
#
# Required by TenantFleetConfig.from_environment() in
# platform/deployment_fargate/lambda_control_plane/utils/get_fleet_config.py
#
# NEVER commit real values.

AWS_REGION=us-east-1

# --- From Terraform outputs (modules/fargate_fleet) ---
OPENSRE_FARGATE_CLUSTER_ARN=arn:aws:ecs:us-east-1:123456789012:cluster/opensre-gateways
OPENSRE_ECS_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/opensre-gateway-execution
OPENSRE_GATEWAY_LOG_GROUP=/opensre/gateways
OPENSRE_FARGATE_SUBNET_IDS=subnet-aaa,subnet-bbb
# Gateway task SG plus stacks/shared memories client SG (comma-separated).
OPENSRE_FARGATE_SECURITY_GROUP_IDS=sg-gateway-tasks,sg-s3files-client
OPENSRE_S3_FILES_MOUNT_SECURITY_GROUP_IDS=sg-s3files-mount-targets

# --- Existing shared resources (from stacks/shared memories[env] output) ---
OPENSRE_S3_FILESYSTEM_ID=fs-123
OPENSRE_S3_FILESYSTEM_ARN=arn:aws:s3files:us-east-1:123456789012:file-system/fs-123
OPENSRE_GATEWAY_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/opensre@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
OPENSRE_CREDENTIALS_API_URL=https://credentials.example.com

# --- Optional fleet tuning ---
OPENSRE_FARGATE_RESOURCE_PREFIX=opensre
OPENSRE_TENANT_UID=10001
OPENSRE_TENANT_GID=10001
OPENSRE_MAX_ACTIVE_ORGANIZATIONS=10

# --- Control-plane database (Neon) — not created by the fleet module ---
# DATABASE_URL=postgresql://...
